# Copy to .env.local and fill in. Never commit .env.local.
# Names only in docs and handover notes, never values.

# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase > Connect > ORMs > Drizzle (transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Resend > API keys (starts with re_). Optional: without it, emails stay queued in the outbox.
RESEND_API_KEY=
# Sender. Without a verified domain, Resend only delivers to your own account address.
EMAIL_FROM=Kinora <onboarding@resend.dev>

# Stripe > Developers > API keys, test mode only (starts with sk_test_).
# Optional: without it, the booking page stops before payment.
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > endpoint /api/stripe/webhook, event
# checkout.session.completed: its signing secret (starts with whsec_).
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# Vercel > Project > Settings > Environment Variables, Production: a random
# string of at least 16 characters (`openssl rand -hex 32`). Vercel sends it
# to the daily jobs in vercel.json: /api/cron/reminders (16:00 UTC) and
# /api/cron/demo-cleanup (03:00 UTC). Without it, both answer 503: no reminder
# goes out, and demo clinics are only deleted when a new visitor tries the demo.
CRON_SECRET=
